{
  "name": "@relayfile/control",
  "version": "0.1.0",
  "private": true,
  "description": "Integration webhook ingest for Relayfile",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "migrations",
    "openapi.yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 'test/**/*.test.ts'",
    "start": "node dist/server.js",
    "dev": "node --import tsx src/server.ts"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
